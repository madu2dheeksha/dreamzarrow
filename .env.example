# ── Site ────────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.dreaamzarrowhomes.com

# ── Enquiry delivery ────────────────────────────────────────────────────
# Leads go to every channel that is configured. If none are configured,
# the forms tell visitors to use WhatsApp or phone instead (no fake success).

# Email via Resend (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@dreaamzarrowhomes.com          # comma-separate for several recipients
ENQUIRY_FROM_EMAIL="DreaamzArrow Homes Website <website@dreaamzarrowhomes.com>"

# Optional: POST each lead as JSON to a CRM / Zapier / Make / Google Apps Script webhook.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=                                  # sent as "Authorization: Bearer <secret>"

# Testing only: point the email channel at a mock server instead of Resend.
# RESEND_API_URL=http://localhost:4555/resend

# ── WhatsApp AI automation (see docs/WHATSAPP-AUTOMATION.md) ────────────
# All optional: without them the site works exactly as before.
# Server-only secrets — never prefix these with NEXT_PUBLIC_.

# Meta WhatsApp Business Cloud API
META_WHATSAPP_TOKEN=                # System-user permanent access token
META_PHONE_NUMBER_ID=               # WhatsApp Manager → Phone numbers → Phone number ID
META_BUSINESS_ACCOUNT_ID=           # WhatsApp Business Account ID
META_APP_SECRET=                    # Meta app → Settings → Basic → App secret (verifies webhook signatures)
META_WEBHOOK_VERIFY_TOKEN=          # Any long random string; paste the same value in Meta's webhook settings
# META_GRAPH_API_VERSION=v24.0

# Message template names (must match the approved templates in WhatsApp Manager)
# WA_TEMPLATE_WELCOME=dza_enquiry_welcome
# WA_TEMPLATE_FOLLOWUP_1=dza_followup_1
# WA_TEMPLATE_FOLLOWUP_2=dza_followup_2
# WA_TEMPLATE_FOLLOWUP_3=dza_followup_3
# WA_TEMPLATE_STAFF_ALERT=dza_staff_lead_alert
# WA_TEMPLATE_LANGUAGE=en

# OpenAI (AI assistant)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_ASSISTANT_ENABLED=true         # set to false to pause the AI; chats are then handed to staff

# Supabase (leads database + dashboard sign-in)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # secret — server only
NEXT_PUBLIC_SUPABASE_URL=           # same URL as above
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # public anon key — used only to sign staff in

# Vercel Cron (daily follow-ups). Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
